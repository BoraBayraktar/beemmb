generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id                 String           @id @default(cuid())
  slug               String           @unique
  name               String
  trendyolCategoryId Int?
  pazaramaCategoryId String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deleted            Boolean          @default(false)
  deletedDate        DateTime?
  deletedUserId      String?
  parentId           String?
  Category           Category?        @relation("CategoryToCategory", fields: [parentId], references: [id])
  other_Category     Category[]       @relation("CategoryToCategory")
  products           Product[]
  storefrontItems    StorefrontItem[]

  @@index([deleted])
  @@index([parentId])
  @@index([trendyolCategoryId])
  @@index([pazaramaCategoryId])
}

model Brand {
  id              String    @id @default(cuid())
  slug            String    @unique
  name            String
  trendyolBrandId Int?
  pazaramaBrandId String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deleted         Boolean   @default(false)
  deletedDate     DateTime?
  deletedUserId   String?
  products        Product[]

  @@index([deleted, isActive])
  @@index([trendyolBrandId])
  @@index([pazaramaBrandId])
}

model Cari {
  id                     String                 @id @default(cuid())
  slug                   String                 @unique
  name                   String
  email                  String?
  phone                  String?
  taxNumber              String?
  taxOffice              String?
  photoUrl               String?
  iban                   String?
  bankName               String?
  bankAccountHolder      String?
  contactPersonName      String?
  contactPersonPhone     String?
  contactPersonEmail     String?
  address                String?
  note                   String?
  defaultPaymentTermDays Int?
  creditLimit            Decimal?               @db.Decimal(12, 2)
  isCustomer             Boolean                @default(false)
  isSupplier             Boolean                @default(false)
  isCarrier              Boolean                @default(false)
  isActive               Boolean                @default(true)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  deleted                Boolean                @default(false)
  deletedDate            DateTime?
  deletedUserId          String?
  carrierProfile         CariCarrierProfile?
  orders                 Order[]                @relation("OrderCari")
  carrierOrders          Order[]                @relation("OrderCarrierCari")
  businessDocuments      BusinessDocument[]
  cashTransactions       CashTransaction[]
  negotiableInstruments  NegotiableInstrument[]
  financeAccountEntries  FinanceAccountEntry[]
  paymentRecords         PaymentRecord[]
  incomingInvoices       IncomingInvoice[]
  primaryProducts        Product[]

  @@index([deleted, isActive])
  @@index([isCustomer])
  @@index([isSupplier])
  @@index([isCarrier])
  @@index([taxNumber])
  @@index([email])
}

model CariCarrierProfile {
  id                      String    @id @default(cuid())
  cariId                  String    @unique
  trackingUrlTemplate     String?
  externalCodeTrendyol    Int?
  externalCodePazarama    String?
  externalCodeHepsiburada String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  cari                    Cari      @relation(fields: [cariId], references: [id])
}

model FinancialAccount {
  id                    String                 @id @default(cuid())
  name                  String
  type                  FinancialAccountType
  currency              String                 @default("TRY")
  openingBalance        Decimal                @default(0) @db.Decimal(10, 2)
  isActive              Boolean                @default(true)
  note                  String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deleted               Boolean                @default(false)
  deletedDate           DateTime?
  deletedUserId         String?
  transactions          CashTransaction[]
  collectionRecords     CollectionRecord[]
  paymentRecords        PaymentRecord[]
  bankStatementImports  BankStatementImport[]
  negotiableInstruments NegotiableInstrument[]
  financeAccountEntries FinanceAccountEntry[]

  @@index([deleted, isActive])
  @@index([type, isActive])
}

model CashTransaction {
  id                   String                          @id @default(cuid())
  accountId            String
  direction            CashTransactionDirection
  sourceType           CashTransactionSourceType       @default(MANUAL)
  category             CashTransactionCategory?
  status               CashTransactionStatus           @default(RECORDED)
  amount               Decimal                         @db.Decimal(10, 2)
  currency             String                          @default("TRY")
  transactionAt        DateTime
  title                String
  note                 String?
  sourceReferenceId    String?
  counterpartyKind     CashTransactionCounterpartyKind @default(UNREGISTERED)
  cariId               String?
  counterpartyName     String?
  createdByUserId      String?
  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt
  deleted              Boolean                         @default(false)
  deletedDate          DateTime?
  deletedUserId        String?
  account              FinancialAccount                @relation(fields: [accountId], references: [id])
  cari                 Cari?                            @relation(fields: [cariId], references: [id])
  reconciliationMatch  BankReconciliationMatch?
  negotiableInstrument NegotiableInstrument?

  @@index([accountId, transactionAt])
  @@index([status, transactionAt])
  @@index([deleted, transactionAt])
  @@index([sourceType, sourceReferenceId])
  @@index([cariId, transactionAt])
}

model BankStatementImport {
  id                 String                    @id @default(cuid())
  financialAccountId String
  fileName           String?
  periodStart        DateTime?
  periodEnd          DateTime?
  status             BankStatementImportStatus @default(DRAFT)
  importedByUserId   String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  financialAccount   FinancialAccount          @relation(fields: [financialAccountId], references: [id])
  lines              BankStatementLine[]

  @@index([financialAccountId, createdAt])
  @@index([status])
}

model BankStatementLine {
  id            String                       @id @default(cuid())
  importId      String
  lineIndex     Int
  transactionAt DateTime
  description   String
  amount        Decimal                      @db.Decimal(10, 2)
  signedAmount  Decimal                      @db.Decimal(10, 2)
  balanceAfter  Decimal?                     @db.Decimal(10, 2)
  matchStatus   BankStatementLineMatchStatus @default(UNMATCHED)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  import        BankStatementImport          @relation(fields: [importId], references: [id], onDelete: Cascade)
  match         BankReconciliationMatch?

  @@unique([importId, lineIndex])
  @@index([importId, matchStatus])
}

model BankReconciliationMatch {
  id                String                        @id @default(cuid())
  statementLineId   String                        @unique
  cashTransactionId String?                       @unique
  status            BankReconciliationMatchStatus @default(SUGGESTED)
  confirmedAt       DateTime?
  confirmedByUserId String?
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  statementLine     BankStatementLine             @relation(fields: [statementLineId], references: [id], onDelete: Cascade)
  cashTransaction   CashTransaction?              @relation(fields: [cashTransactionId], references: [id])

  @@index([status])
}

model NegotiableInstrument {
  id                 String                          @id @default(cuid())
  instrumentNumber   String
  instrumentType     NegotiableInstrumentType
  direction          NegotiableInstrumentDirection
  status             NegotiableInstrumentStatus      @default(PORTFOLIO)
  amount             Decimal                         @db.Decimal(10, 2)
  currency           String                          @default("TRY")
  dueDate            DateTime
  issueDate          DateTime?
  counterpartyKind   CashTransactionCounterpartyKind @default(UNREGISTERED)
  cariId             String?
  counterpartyName   String?
  endorserName       String?
  note               String?
  financialAccountId String?
  cashTransactionId  String?                         @unique
  createdByUserId    String?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  deleted            Boolean                         @default(false)
  deletedDate        DateTime?
  deletedUserId      String?
  cari               Cari?                            @relation(fields: [cariId], references: [id])
  financialAccount   FinancialAccount?               @relation(fields: [financialAccountId], references: [id])
  cashTransaction    CashTransaction?                @relation(fields: [cashTransactionId], references: [id])

  @@index([status, dueDate])
  @@index([direction, dueDate])
  @@index([deleted, dueDate])
  @@index([cariId])
}

model ProductAttributeDefinition {
  id                       String                                    @id @default(cuid())
  slug                     String                                    @unique
  name                     String
  trendyolAttributeId      Int?
  displayType              ProductAttributeDisplayType               @default(TEXT)
  sortOrder                Int                                       @default(0)
  isActive                 Boolean                                   @default(true)
  createdAt                DateTime                                  @default(now())
  updatedAt                DateTime                                  @updatedAt
  deleted                  Boolean                                   @default(false)
  deletedDate              DateTime?
  deletedUserId            String?
  marketplaceValueMappings ProductAttributeValueMarketplaceMapping[]
  productLinks             ProductAttributeLink[]
  variantValues            ProductVariantAttributeValue[]

  @@index([deleted, isActive, sortOrder])
  @@index([trendyolAttributeId])
}

model ProductAttributeValueMarketplaceMapping {
  id                         String                     @id @default(cuid())
  attributeDefinitionId      String
  channel                    IntegrationChannel
  localValue                 String
  externalAttributeValueId   Int?
  externalAttributeValueName String?
  customAttributeValue       String?
  isActive                   Boolean                    @default(true)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  deleted                    Boolean                    @default(false)
  deletedDate                DateTime?
  deletedUserId              String?
  attributeDefinition        ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])

  @@unique([attributeDefinitionId, channel, localValue])
  @@index([channel, deleted, isActive])
  @@index([attributeDefinitionId, deleted])
}

model Product {
  id                           String                        @id @default(cuid())
  slug                         String                        @unique
  name                         String
  description                  String
  barcode                      String?
  unitType                     ProductUnitType               @default(PIECE)
  productType                  ProductType                   @default(PHYSICAL)
  price                        Decimal                       @db.Decimal(10, 2)
  purchasePrice                Decimal?                      @db.Decimal(10, 2)
  currency                     String                        @default("TRY")
  vatRate                      Int                           @default(20)
  stockTrackingEnabled         Boolean                       @default(true)
  imageUrl                     String
  imageUrls                    String[]                      @default([])
  categoryId                   String?
  brandId                      String?
  primaryCariId                String?
  status                       ProductStatus                 @default(ACTIVE)
  salesEnabled                 Boolean                       @default(true)
  purchaseEnabled              Boolean                       @default(true)
  internalNote                 String?
  searchKeywords               String[]                      @default([])
  preferredSalesWarehouseId    String?
  preferredPurchaseWarehouseId String?
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  deleted                      Boolean                       @default(false)
  deletedDate                  DateTime?
  deletedUserId                String?
  sku                          String                        @unique
  compareAtPrice               Decimal?                      @db.Decimal(10, 2)
  stock                        Int                           @default(0)
  orderItems                   OrderItem[]
  brand                        Brand?                        @relation(fields: [brandId], references: [id])
  category                     Category?                     @relation(fields: [categoryId], references: [id])
  inventoryItem                InventoryItem?
  interaction                  ProductInteraction?
  primaryCari                  Cari?                         @relation(fields: [primaryCariId], references: [id])
  preferredSalesWarehouse      Warehouse?                    @relation("PreferredSalesWarehouseProducts", fields: [preferredSalesWarehouseId], references: [id])
  preferredPurchaseWarehouse   Warehouse?                    @relation("PreferredPurchaseWarehouseProducts", fields: [preferredPurchaseWarehouseId], references: [id])
  reviews                      ProductReview[]
  questions                    ProductQuestion[]
  attributeLinks               ProductAttributeLink[]
  variants                     ProductVariant[]
  storefrontItems              StorefrontItem[]
  externalStockEvents          ExternalStockEvent[]
  inventoryIntegrationMappings InventoryIntegrationMapping[]
  marketplaceOrderLines        MarketplaceOrderLine[]
  purchaseReceiptLines         PurchaseReceiptLine[]
  businessDocumentLines        BusinessDocumentLine[]
  inventoryHistoryEvents       InventoryHistoryEvent[]

  @@index([categoryId])
  @@index([brandId])
  @@index([primaryCariId])
  @@index([barcode])
  @@index([deleted])
  @@index([status, salesEnabled])
  @@index([preferredSalesWarehouseId])
  @@index([preferredPurchaseWarehouseId])
  @@index([stock])
}

model ProductAttributeLink {
  id                    String                     @id @default(cuid())
  productId             String
  attributeDefinitionId String
  isVariantAxis         Boolean                    @default(false)
  sortOrder             Int                        @default(0)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  product               Product                    @relation(fields: [productId], references: [id])

  @@unique([productId, attributeDefinitionId])
  @@index([attributeDefinitionId, isVariantAxis])
  @@index([productId, sortOrder])
}

model ProductVariant {
  id                     String                         @id @default(cuid())
  productId              String
  slug                   String                         @unique
  sku                    String                         @unique
  barcode                String?
  title                  String
  optionSummary          String
  priceOverride          Decimal?                       @db.Decimal(10, 2)
  purchasePriceOverride  Decimal?                       @db.Decimal(10, 2)
  compareAtPriceOverride Decimal?                       @db.Decimal(10, 2)
  imageUrl               String?
  imageUrls              String[]                       @default([])
  stockOverride          Int?
  salesEnabled           Boolean                        @default(true)
  isDefault              Boolean                        @default(false)
  sortOrder              Int                            @default(0)
  createdAt              DateTime                       @default(now())
  updatedAt              DateTime                       @updatedAt
  deleted                Boolean                        @default(false)
  deletedDate            DateTime?
  deletedUserId          String?
  product                Product                        @relation(fields: [productId], references: [id])
  attributeValues        ProductVariantAttributeValue[]
  inventoryItem          InventoryItem?
  orderItems             OrderItem[]
  marketplaceOrderLines  MarketplaceOrderLine[]
  purchaseReceiptLines   PurchaseReceiptLine[]
  businessDocumentLines  BusinessDocumentLine[]

  @@index([productId, deleted, salesEnabled, sortOrder])
  @@index([barcode])
}

model ProductVariantAttributeValue {
  id                    String                     @id @default(cuid())
  productVariantId      String
  attributeDefinitionId String
  value                 String
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  attributeDefinition   ProductAttributeDefinition @relation(fields: [attributeDefinitionId], references: [id])
  productVariant        ProductVariant             @relation(fields: [productVariantId], references: [id])

  @@unique([productVariantId, attributeDefinitionId])
  @@index([attributeDefinitionId, value])
}

model ProductReview {
  id               String    @id @default(cuid())
  productId        String
  authorUserId     String? // Application-level, not a foreign key
  authorName       String
  rating           Int
  title            String
  comment          String
  verifiedPurchase Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deleted          Boolean   @default(false)
  deletedDate      DateTime?
  deletedUserId    String?
  product          Product   @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([deleted])
  @@index([authorUserId])
  @@index([productId, authorUserId])
}

model ProductQuestion {
  id            String    @id @default(cuid())
  productId     String
  question      String
  askedBy       String
  answer        String?
  answeredBy    String?
  answeredAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deleted       Boolean   @default(false)
  deletedDate   DateTime?
  deletedUserId String?
  product       Product   @relation(fields: [productId], references: [id])

  @@index([productId, createdAt])
  @@index([deleted])
}

model ProductInteraction {
  id           String    @id @default(cuid())
  productId    String    @unique
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  product      Product   @relation(fields: [productId], references: [id])

  @@index([viewCount])
}

model Promotion {
  id            String        @id @default(cuid())
  code          String        @unique
  name          String
  type          PromotionType
  value         Decimal       @db.Decimal(10, 2)
  currency      String        @default("TRY")
  minSubtotal   Decimal?      @db.Decimal(10, 2)
  maxDiscount   Decimal?      @db.Decimal(10, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usedCount     Int           @default(0)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deleted       Boolean       @default(false)
  deletedDate   DateTime?
  deletedUserId String?

  @@index([active, deleted])
  @@index([startsAt, endsAt])
}

model Order {
  id                     String                      @id @default(cuid())
  orderNumber            String                      @unique
  status                 OrderStatus                 @default(CONFIRMED)
  subtotal               Decimal                     @db.Decimal(10, 2)
  currency               String                      @default("TRY")
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deleted                Boolean                     @default(false)
  deletedDate            DateTime?
  deletedUserId          String?
  cariId                 String?
  discountTotal          Decimal                     @default(0) @db.Decimal(10, 2)
  paymentStatus          PaymentStatus               @default(PENDING)
  promotionCode          String?
  total                  Decimal                     @default(0) @db.Decimal(10, 2)
  shipmentStatus         OrderShipmentStatus         @default(NOT_SHIPPED)
  shipmentAddressLine    String?
  shipmentCity           String?
  shipmentDistrict       String?
  shipmentPostalCode     String?
  shipmentCountry        String?                     @default("TR")
  shipmentContactName    String?
  shipmentContactPhone   String?
  invoiceAddressLine     String?
  invoiceCity            String?
  invoiceDistrict        String?
  invoicePostalCode      String?
  carrierCariId          String?
  cargoTrackingNumber    String?
  cargoShippedAt         DateTime?
  cargoDeliveredAt       DateTime?
  shipmentSourceChannel  String?
  externalCarrierNameRaw String?
  items                  OrderItem[]
  inventoryMovements     InventoryMovement[]
  paymentStatusHistory   OrderPaymentStatusHistory[]
  collectionRecords      CollectionRecord[]
  stockReservations      StockReservation[]
  statusHistory          OrderStatusHistory[]
  businessDocuments      BusinessDocument[]
  marketplacePackages    MarketplaceOrderPackage[]
  financeAllocationLinks FinanceAllocationLink[]
  cari                   Cari?                       @relation("OrderCari", fields: [cariId], references: [id])
  carrierCari            Cari?                       @relation("OrderCarrierCari", fields: [carrierCariId], references: [id])

  @@index([deleted])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([status])
  @@index([cariId])
  @@index([carrierCariId])
  @@index([shipmentStatus])
}

model OrderItem {
  id                          String          @id @default(cuid())
  orderId                     String
  productId                   String?
  productVariantId            String?
  productSlug                 String
  productSku                  String
  productVariantSlug          String?
  productVariantSku           String?
  productVariantTitle         String?
  productVariantOptionSummary String?
  productName                 String
  productImageUrl             String
  quantity                    Int
  unitPrice                   Decimal         @db.Decimal(10, 2)
  compareAtPrice              Decimal?        @db.Decimal(10, 2)
  lineTotal                   Decimal         @db.Decimal(10, 2)
  currency                    String
  createdAt                   DateTime        @default(now())
  updatedAt                   DateTime        @updatedAt
  deleted                     Boolean         @default(false)
  deletedDate                 DateTime?
  deletedUserId               String?
  order                       Order           @relation(fields: [orderId], references: [id])
  product                     Product?        @relation(fields: [productId], references: [id])
  productVariant              ProductVariant? @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([productVariantId])
  @@index([deleted])
}

model OrderStatusHistory {
  id              String                  @id @default(cuid())
  orderId         String
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  source          OrderStatusChangeSource @default(SYSTEM)
  changedByUserId String?
  note            String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  deleted         Boolean                 @default(false)
  deletedDate     DateTime?
  deletedUserId   String?
  order           Order                   @relation(fields: [orderId], references: [id])

  @@index([deleted])
  @@index([orderId, createdAt])
}

model OrderPaymentStatusHistory {
  id              String                    @id @default(cuid())
  orderId         String
  fromStatus      PaymentStatus?
  toStatus        PaymentStatus
  source          PaymentStatusChangeSource @default(SYSTEM)
  changedByUserId String?
  note            String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  deleted         Boolean                   @default(false)
  deletedDate     DateTime?
  deletedUserId   String?
  order           Order                     @relation(fields: [orderId], references: [id])

  @@index([deleted])
  @@index([orderId, createdAt])
}

model CollectionRecord {
  id                         String                  @id @default(cuid())
  orderId                    String
  financialAccountId         String?
  amount                     Decimal                 @db.Decimal(10, 2)
  currency                   String                  @default("TRY")
  status                     CollectionRecordStatus  @default(RECORDED)
  collectedAt                DateTime
  note                       String?
  recordedByUserId           String?
  onlineCollectionProvider   String?
  onlineCollectionExternalId String?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  deleted                    Boolean                 @default(false)
  deletedDate                DateTime?
  deletedUserId              String?
  order                      Order                   @relation(fields: [orderId], references: [id])
  financialAccount           FinancialAccount?       @relation(fields: [financialAccountId], references: [id])
  allocationLinks            FinanceAllocationLink[]

  @@unique([onlineCollectionProvider, onlineCollectionExternalId])
  @@index([orderId, collectedAt])
  @@index([financialAccountId, collectedAt])
  @@index([status, collectedAt])
  @@index([deleted, collectedAt])
}

model PaymentRecord {
  id                 String                  @id @default(cuid())
  cariId             String?
  financialAccountId String?
  amount             Decimal                 @db.Decimal(10, 2)
  currency           String                  @default("TRY")
  status             PaymentRecordStatus     @default(RECORDED)
  paidAt             DateTime
  note               String?
  recordedByUserId   String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  deleted            Boolean                 @default(false)
  deletedDate        DateTime?
  deletedUserId      String?
  cari               Cari?                   @relation(fields: [cariId], references: [id])
  financialAccount   FinancialAccount?       @relation(fields: [financialAccountId], references: [id])
  allocationLinks    FinanceAllocationLink[]

  @@index([cariId, paidAt])
  @@index([financialAccountId, paidAt])
  @@index([status, paidAt])
  @@index([deleted, paidAt])
}

model FinanceLedgerAccount {
  id            String                       @id @default(cuid())
  code          String                       @unique
  name          String
  category      FinanceLedgerAccountCategory
  isActive      Boolean                      @default(true)
  deleted       Boolean                      @default(false)
  deletedDate   DateTime?
  deletedUserId String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt
  entries       FinanceAccountEntry[]

  @@index([isActive, code])
  @@index([deleted])
}

model FinanceAccountEntry {
  id                 String                        @id @default(cuid())
  lineKey            String                        @unique
  entryAt            DateTime
  ledgerAccountId    String
  side               FinanceAccountEntrySide
  amount             Decimal                       @db.Decimal(10, 2)
  currency           String                        @default("TRY")
  sourceType         FinanceAccountEntrySourceType
  sourceId           String
  sourceReference    String?
  title              String
  note               String?
  cariId             String?
  financialAccountId String?
  createdAt          DateTime                      @default(now())
  ledgerAccount      FinanceLedgerAccount          @relation(fields: [ledgerAccountId], references: [id])
  cari               Cari?                          @relation(fields: [cariId], references: [id])
  financialAccount   FinancialAccount?             @relation(fields: [financialAccountId], references: [id])

  @@index([entryAt])
  @@index([sourceType, sourceId])
  @@index([ledgerAccountId, entryAt])
  @@index([cariId])
}

model FinanceAllocationLink {
  id                     String                      @id @default(cuid())
  collectionRecordId     String?
  paymentRecordId        String?
  targetType             FinanceAllocationTargetType
  orderId                String?
  businessDocumentId     String?
  businessDocumentLineId String?
  amount                 Decimal                     @db.Decimal(10, 2)
  currency               String                      @default("TRY")
  createdAt              DateTime                    @default(now())
  updatedAt              DateTime                    @updatedAt
  deleted                Boolean                     @default(false)
  deletedDate            DateTime?
  deletedUserId          String?
  collectionRecord       CollectionRecord?           @relation(fields: [collectionRecordId], references: [id])
  paymentRecord          PaymentRecord?              @relation(fields: [paymentRecordId], references: [id])
  order                  Order?                      @relation(fields: [orderId], references: [id])
  businessDocument       BusinessDocument?           @relation(fields: [businessDocumentId], references: [id])
  businessDocumentLine   BusinessDocumentLine?       @relation(fields: [businessDocumentLineId], references: [id])

  @@index([collectionRecordId])
  @@index([paymentRecordId])
  @@index([orderId])
  @@index([businessDocumentId])
  @@index([businessDocumentLineId])
  @@index([deleted, createdAt])
}

model BusinessDocument {
  id                     String                               @id @default(cuid())
  documentNumber         String                               @unique
  documentType           BusinessDocumentType
  status                 BusinessDocumentStatus               @default(DRAFT)
  issueDate              DateTime
  dueDate                DateTime?
  currency               String                               @default("TRY")
  totalAmount            Decimal?                             @db.Decimal(10, 2)
  externalReference      String?
  externalSystemStatus   BusinessDocumentSyncStatus           @default(NOT_SENT)
  providerConfigId       String?
  counterpartyName       String
  counterpartyTaxNumber  String?
  counterpartyTaxOffice  String?
  counterpartyEmail      String?
  counterpartyAddress    String?
  note                   String?
  cariId                 String?
