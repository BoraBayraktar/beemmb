  externalSku           String?
  externalWarehouseCode String?
  mappingId             String?
  productId             String?
  warehouseId           String?
  quantity              Int
  reference             String?
  note                  String?
  payload               Json?
  appliedOnHand         Int?
  appliedAvailable      Int?
  errorMessage          String?
  processedAt           DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  mapping               InventoryIntegrationMapping? @relation(fields: [mappingId], references: [id])
  product               Product?                     @relation(fields: [productId], references: [id])
  warehouse             Warehouse?                   @relation(fields: [warehouseId], references: [id])

  @@index([channel, status, createdAt])
  @@index([mappingId])
  @@index([productId, warehouseId])
}

model StorefrontItem {
  id            String                @id @default(cuid())
  section       StorefrontSection
  variant       String
  titleTr       String
  titleEn       String
  descriptionTr String
  descriptionEn String
  sortOrder     Int
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deleted       Boolean               @default(false)
  deletedDate   DateTime?
  deletedUserId String?
  categoryId    String?
  productId     String?
  targetType    StorefrontTargetType?
  category      Category?             @relation(fields: [categoryId], references: [id])
  product       Product?              @relation(fields: [productId], references: [id])

  @@index([deleted])
  @@index([categoryId])
  @@index([productId])
  @@index([section, deleted, sortOrder])
  @@index([startsAt, endsAt])
  @@index([targetType])
}

model Tenant {
  id               String                    @id @default(cuid())
  slug             String                    @unique
  name             String
  legalName        String?
  taxNumber        String?
  contactEmail     String
  contactPhone     String?
  status           TenantStatus              @default(ACTIVE)
  isPlatformTenant Boolean                   @default(false)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  deleted          Boolean                   @default(false)
  deletedDate      DateTime?
  deletedUserId    String?
  users            User[]
  entitlements     TenantModuleEntitlement[]

  @@index([deleted, status])
}

enum TenantStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  ARCHIVED
}

model ModuleCatalog {
  id           String                    @id @default(cuid())
  key          String                    @unique
  name         String
  description  String?
  sortOrder    Int                       @default(0)
  isActive     Boolean                   @default(true)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  entitlements TenantModuleEntitlement[]
}

model TenantModuleEntitlement {
  id              String        @id @default(cuid())
  tenantId        String
  moduleKey       String
  isEnabled       Boolean       @default(true)
  validFrom       DateTime?
  validUntil      DateTime?
  grantedByUserId String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module          ModuleCatalog @relation(fields: [moduleKey], references: [key], onDelete: Restrict)

  @@unique([tenantId, moduleKey])
  @@index([tenantId, isEnabled])
}

model User {
  id                       String                   @id @default(cuid())
  tenantId                 String
  email                    String                   @unique
  name                     String
  passwordHash             String
  role                     UserRole                 @default(EDITOR)
  isSuperAdmin             Boolean                  @default(false)
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  deleted                  Boolean                  @default(false)
  deletedDate              DateTime?
  deletedUserId            String?
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id])
  notifications            UserNotification[]
  socialAccounts           SocialAccount[]
  inventoryPreference      UserInventoryPreference?
  inventoryExportHistories InventoryExportHistory[]
  roleAssignments          UserRoleAssignment[]

  @@index([deleted])
  @@index([tenantId])
}

model Role {
  id              String               @id @default(cuid())
  key             String               @unique
  name            String
  description     String?
  isSystem        Boolean              @default(false)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deleted         Boolean              @default(false)
  deletedDate     DateTime?
  deletedUserId   String?
  permissions     RolePermission[]
  userAssignments UserRoleAssignment[]

  @@index([deleted, isActive])
}

model Permission {
  id            String           @id @default(cuid())
  key           String           @unique
  module        String
  action        String
  menuKey       String?
  name          String
  description   String?
  deleted       Boolean          @default(false)
  deletedDate   DateTime?
  deletedUserId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  roles         RolePermission[]

  @@index([module, action])
  @@index([menuKey])
  @@index([deleted])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRoleAssignment {
  id               String   @id @default(cuid())
  userId           String
  roleId           String
  assignedByUserId String?
  assignedAt       DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role             Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@index([assignedByUserId])
}

model InventoryExportHistory {
  id                 String   @id @default(cuid())
  actorUserId        String?
  total              Int      @default(0)
  search             String?
  stockStatusFilter  String?
  reservationFilter  String?
  warehouseFilter    String?
  movementTypeFilter String?
  createdAt          DateTime @default(now())
  actor              User?    @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

model UserInventoryPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  compactInventoryList Boolean  @default(false)
  visibleColumns       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id])
}

model SocialAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@index([userId, provider])
}

model UserNotification {
  id        String                  @id @default(cuid())
  userId    String
  type      UserNotificationType
  channel   UserNotificationChannel
  title     String
  message   String
  linkUrl   String?
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime                @default(now())
  user      User                    @relation(fields: [userId], references: [id])

  @@index([userId, channel, createdAt])
  @@index([userId, channel, readAt])
  @@index([channel, sentAt])
}

model AuditLog {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String?
  action           String
  actorUserId      String?
  actorType        String   @default("USER")
  tenantId         String?
  module           String?
  route            String?
  operation        String?
  requestId        String?
  correlationId    String?
  ipAddress        String?
  userAgent        String?
  summary          String?
  metadata         Json?
  payloadHash      String?
  previousHash     String?
  chainHash        String?
  hashAlgorithm    String   @default("SHA-256")
  occurredAt       DateTime @default(now())
  serverReceivedAt DateTime @default(now())
  timezone         String   @default("Europe/Istanbul")
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([requestId])
  @@index([chainHash])
}

model AuditAnchor {
  id               String   @id @default(cuid())
  anchorType       String
  periodStart      DateTime
  periodEnd        DateTime
  recordCount      Int
  firstAuditLogId  String?
  lastAuditLogId   String?
  firstChainHash   String?
  lastChainHash    String?
  manifestHash     String
  storageBucket    String?
  storageObjectKey String?
  storageUrl       String?
  storageMode      String   @default("LOCAL")
  status           String   @default("CREATED")
  errorMessage     String?
  createdByUserId  String?
  createdAt        DateTime @default(now())

  @@index([periodStart, periodEnd])
  @@index([manifestHash])
  @@index([createdAt])
}

model InventoryHistoryEvent {
  id                String                     @id @default(cuid())
  eventType         InventoryHistoryEventType
  entityType        InventoryHistoryEntityType
  entityId          String?
  productId         String?
  warehouseId       String?
  transactionId     String?
  stockCountId      String?
  purchaseReceiptId String?
  actorUserId       String?
  title             String
  summary           String
  metadata          Json?
  createdAt         DateTime                   @default(now())
  product           Product?                   @relation(fields: [productId], references: [id])
  warehouse         Warehouse?                 @relation(fields: [warehouseId], references: [id])

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([entityType, createdAt])
  @@index([productId, createdAt])
  @@index([warehouseId, createdAt])
  @@index([actorUserId, createdAt])
}

